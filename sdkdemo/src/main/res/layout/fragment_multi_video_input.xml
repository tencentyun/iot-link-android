<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/btn_login"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- 统一配置卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/gray_F7F9FA"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="统一配置（跟随设备配置）"
                        android:textColor="@color/black"
                        android:textSize="@dimen/ts_16"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/black_1A000000" />

                    <include
                        android:id="@+id/app_key_layout"
                        layout="@layout/input_item_layout"
                        android:layout_width="match_parent"
                        android:layout_height="56dp" />

                    <include
                        android:id="@+id/app_secret_layout"
                        layout="@layout/input_item_layout"
                        android:layout_width="match_parent"
                        android:layout_height="56dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 设备1卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/gray_F7F9FA"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="设备1"
                            android:textColor="@color/black"
                            android:textSize="@dimen/ts_17"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btn_paste_device1"
                            android:layout_width="60dp"
                            android:layout_height="30dp"
                            android:background="@drawable/background_blue_cell"
                            android:text="粘贴"
                            android:textColor="@color/blue_0052D9" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/black_1A000000" />

                    <include
                        android:id="@+id/device1_product_id_layout"
                        layout="@layout/input_item_layout"
                        android:layout_width="match_parent"
                        android:layout_height="56dp" />

                    <include
                        android:id="@+id/device1_device_name_layout"
                        layout="@layout/input_item_layout"
                        android:layout_width="match_parent"
                        android:layout_height="56dp" />

                    <include
                        android:id="@+id/device1_p2p_info_layout"
                        layout="@layout/input_item_layout"
                        android:layout_width="match_parent"
                        android:layout_height="56dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/black_1A000000" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="使用统一配置"
                            android:textColor="@color/black_888888"
                            android:textSize="@dimen/ts_14" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switch_device1_follow_config"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 设备2卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/gray_F7F9FA"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="设备2"
                            android:textColor="@color/black"
                            android:textSize="@dimen/ts_17"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btn_paste_device2"
                            android:layout_width="60dp"
                            android:layout_height="30dp"
                            android:background="@drawable/background_blue_cell"
                            android:text="粘贴"
                            android:textColor="@color/blue_0052D9" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/black_1A000000" />

                    <include
                        android:id="@+id/device2_product_id_layout"
                        layout="@layout/input_item_layout"
                        android:layout_width="match_parent"
                        android:layout_height="56dp" />

                    <include
                        android:id="@+id/device2_device_name_layout"
                        layout="@layout/input_item_layout"
                        android:layout_width="match_parent"
                        android:layout_height="56dp" />

                    <include
                        android:id="@+id/device2_p2p_info_layout"
                        layout="@layout/input_item_layout"
                        android:layout_width="match_parent"
                        android:layout_height="56dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/black_1A000000" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="使用统一配置"
                            android:textColor="@color/black_888888"
                            android:textSize="@dimen/ts_14" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switch_device2_follow_config"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 设备3卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/gray_F7F9FA"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="设备3"
                            android:textColor="@color/black"
                            android:textSize="@dimen/ts_17"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btn_paste_device3"
                            android:layout_width="60dp"
                            android:layout_height="30dp"
                            android:background="@drawable/background_blue_cell"
                            android:text="粘贴"
                            android:textColor="@color/blue_0052D9" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/black_1A000000" />

                    <include
                        android:id="@+id/device3_product_id_layout"
                        layout="@layout/input_item_layout"
                        android:layout_width="match_parent"
                        android:layout_height="56dp" />

                    <include
                        android:id="@+id/device3_device_name_layout"
                        layout="@layout/input_item_layout"
                        android:layout_width="match_parent"
                        android:layout_height="56dp" />

                    <include
                        android:id="@+id/device3_p2p_info_layout"
                        layout="@layout/input_item_layout"
                        android:layout_width="match_parent"
                        android:layout_height="56dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/black_1A000000" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="使用统一配置"
                            android:textColor="@color/black_888888"
                            android:textSize="@dimen/ts_14" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switch_device3_follow_config"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 设备4卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/gray_F7F9FA"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="设备4"
                            android:textColor="@color/black"
                            android:textSize="@dimen/ts_17"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btn_paste_device4"
                            android:layout_width="60dp"
                            android:layout_height="30dp"
                            android:background="@drawable/background_blue_cell"
                            android:text="粘贴"
                            android:textColor="@color/blue_0052D9" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/black_1A000000" />

                    <include
                        android:id="@+id/device4_product_id_layout"
                        layout="@layout/input_item_layout"
                        android:layout_width="match_parent"
                        android:layout_height="56dp" />

                    <include
                        android:id="@+id/device4_device_name_layout"
                        layout="@layout/input_item_layout"
                        android:layout_width="match_parent"
                        android:layout_height="56dp" />

                    <include
                        android:id="@+id/device4_p2p_info_layout"
                        layout="@layout/input_item_layout"
                        android:layout_width="match_parent"
                        android:layout_height="56dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/black_1A000000" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="使用统一配置"
                            android:textColor="@color/black_888888"
                            android:textSize="@dimen/ts_14" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switch_device4_follow_config"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>


        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_login"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/background_blue_btn"
        android:text="开始连接"
        android:textColor="@color/white"
        android:textSize="@dimen/ts_17"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
